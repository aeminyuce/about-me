{
    "compilerOptions": {
        "paths": {
            "@jsconfig": ["./jsconfig.json"],
            "@cssconfig": ["./cssconfig.css"],

            "@ui/*": ["./node_modules/uilab/react/*"],
            "@css/*": ["./node_modules/uilab/css/*"],
            "@js/*": ["./node_modules/uilab/js/*"],

            "@icon/*": ["./node_modules/uilab-icons/react/*"],
            "@sprite/*": ["./node_modules/uilab-icons/sprite/*"],

            "@assets/*": ["./src/assets/*"],
            "@components/*": ["./src/components/*"],
            "@helpers/*": ["./src/helpers/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@models/*": ["./src/models/*"],
            "@pages/*": ["./src/pages/*"],
            "@services/*": ["./src/services/*"],
            "@skeleton/*": ["./src/skeleton/*"],
            "@stores/*": ["./src/stores/*"]
        },
        "jsx": "react-jsx",
        "allowSyntheticDefaultImports": true,
        "lib": ["dom", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"]
    }
}